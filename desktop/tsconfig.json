{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "vite.config.mts"],
  "exclude": ["node_modules", "dist", "release"]
}